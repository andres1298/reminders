      "html": "<button class=\"ds-btn ds-btn--filled\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Nueva tarea</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px;border-radius:9999px;font:700 16px/1 \"DM Sans\",system-ui,sans-serif;letter-spacing:-.005em;cursor:pointer;transition:transform 120ms cubic-bezier(.16,1,.3,1),box-shadow 120ms cubic-bezier(.16,1,.3,1)}.ds-btn--filled{background:#F2CB66;color:#151515;border:2px solid #151515;box-shadow:0 3px 0 #151515}.ds-btn:active{transform:translateY(3px) scale(.98);box-shadow:0 0 0 #151515}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 3px #FBF6DC,0 0 0 5.5px #151515}"
