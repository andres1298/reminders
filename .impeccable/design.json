      "html": "<nav class=\"ds-tabbar\"><a class=\"ds-tab\" aria-current=\"page\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9v5.5H5.5A1.5 1.5 0 0 1 4 19z\"/></svg><span>Inicio</span></a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 6h10M10 12h10M10 18h10\"/></svg></a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20V10M10 20V4M16 20v-7M21 20H3\"/></svg></a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2.8v2.4M12 18.8v2.4M21.2 12h-2.4M5.2 12H2.8\"/></svg></a></nav>",
      "css": ".ds-tabbar{display:flex;align-items:center;gap:4px;width:340px;height:64px;padding:8px;border-radius:9999px;background:#151515;box-shadow:0 10px 30px rgb(21 21 21 / .28)}.ds-tab{display:flex;align-items:center;justify-content:center;gap:8px;height:48px;width:48px;flex:none;border-radius:9999px;color:rgb(245 241 220 / .72);font:700 14px/1 \"DM Sans\",sans-serif;text-decoration:none;transition:background-color 280ms cubic-bezier(.16,1,.3,1),color 200ms}.ds-tab svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}.ds-tab span{display:none}.ds-tab[aria-current=\"page\"]{flex:1;width:auto;padding:0 14px;background:#F2CB66;color:#151515}.ds-tab[aria-current=\"page\"] span{display:inline}.ds-tab:hover:not([aria-current]){color:#F5F1DC}.ds-tab:active{transform:scale(.94)}.ds-tab:focus-visible{outline:none;box-shadow:0 0 0 3px #151515,0 0 0 5.5px #F2CB66}"
