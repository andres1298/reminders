      "css": ".ds-card{width:176px;min-height:216px;display:flex;flex-direction:column;gap:8px;padding:12px 12px 16px 16px;border-radius:28px;background:var(--card);color:#151515;border:2px solid #151515;box-shadow:0 3px 0 #151515;cursor:pointer;transition:transform 120ms cubic-bezier(.16,1,.3,1),box-shadow 120ms}.ds-card:active{transform:translateY(3px);box-shadow:0 0 0 #151515}.ds-ring{position:relative;width:92px;height:92px;margin:14px auto 0}.ds-ring svg{width:100%;height:100%;transform:rotate(-90deg)}.ds-ring circle{fill:none;stroke:#151515;stroke-width:8}.ds-ring .t{opacity:.15}.ds-ring .b{stroke-linecap:round;stroke-dasharray:100 100;stroke-dashoffset:22}.ds-ring span{position:absolute;inset:0;display:grid;place-items:center;font-size:33px}.ds-card-title{font:750 17px/1.15 \"Bricolage Grotesque\",\"DM Sans\",sans-serif;letter-spacing:-.012em}.ds-card-foot{display:flex;justify-content:space-between;align-items:center;margin-top:auto;gap:6px}.ds-status{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:9999px;font:700 12.5px/1 \"DM Sans\",sans-serif}.ds-status i{width:7px;height:7px;border-radius:50%;background:currentColor}.ds-status--soon{background:#151515;color:#F2CB66}.ds-avatar{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#F3EEDD;border:2px solid #151515;font-size:15px}"
    },
