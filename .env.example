# Copia a .env.local para desarrollo; en Vercel van en Settings → Environment Variables.
# Pasos completos en docs/DEPLOY.md

# Notificaciones push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto para /api/cron/notifications (openssl rand -hex 32)
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (fase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
